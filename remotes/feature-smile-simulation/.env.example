# Hugging Face Inference Providers (free monthly credits)
# 1) Create account: https://huggingface.co/join
# 2) Create token: https://huggingface.co/settings/tokens
#    Enable permission: "Make calls to the Inference Providers"
# 3) Paste token below and restart the smile-simulation remote
VITE_HF_TOKEN=
# Recommended image-edit model (uses free HF credits via Inference Providers)
VITE_HF_IMAGE_MODEL=black-forest-labs/FLUX.1-Kontext-dev
# auto | hf-inference | fal-ai | replicate | together
VITE_HF_PROVIDER=auto
