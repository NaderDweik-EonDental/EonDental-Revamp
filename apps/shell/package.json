{
  "name": "@eon/shell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development rspack serve",
    "build": "tsc -p tsconfig.json --noEmit && NODE_ENV=production rspack build",
