    "react-dom": "19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-router-dom": "^7.7.1",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@module-federation/enhanced": "^0.21.6",
    "@rspack/cli": "^1.5.2",
    "@rspack/core": "^1.5.2",
    "@rspack/plugin-react-refresh": "^1.5.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/semver": "^7.7.0",
    "react-refresh": "^0.17.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
